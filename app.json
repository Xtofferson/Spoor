{
  "expo": {
    "name": "Spoor",
    "slug": "spoor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spoor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.xtofferson.spoor",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.xtofferson.spoor",
      "adaptiveIcon": {
        "backgroundColor": "#5E6B3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3E7CF",
          "image": "./assets/brand/spoor-wordmark@3x.png",
          "imageWidth": 280
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Spoor uses your photos so you can add a picture of a place, like a roadside wood seller.",
          "cameraPermission": "Spoor uses the camera so you can photograph a place to share, like a roadside wood seller.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
